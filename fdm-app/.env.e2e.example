# Settings for the Playwright runs in e2e/ (copy to .env.e2e, which is not committed).
# The app under test always runs on http://localhost:8080 as "MINAS2"; see playwright.config.ts.

# An EMPTY PostGIS database: the seed refuses to run when it already contains farms.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fdm_e2e
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Any long random strings.
BETTER_AUTH_SECRET=
FDM_SESSION_SECRET=

# Screenshots only: the manual shows real results, so these use the real services.
# Nutrient advice, BLN3 indicators and soil estimates need an NMI API key.
NMI_API_KEY=
# Map tiles: "osm" needs no key; "maptiler" needs PUBLIC_MAPTILER_API_KEY.
PUBLIC_MAP_PROVIDER=osm
PUBLIC_MAPTILER_API_KEY=
