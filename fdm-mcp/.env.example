# -------------------------------------
# General Configuration
# -------------------------------------
# Port the MCP server listens on.
# Required: No (defaults to 6174 for local development; 8080 in the container)
PORT=6174

# Public name of the application, shown to AI assistants as the server name.
# Required: Yes
PUBLIC_FDM_NAME=FDM

# Public URL of this service (used for problem type links in error responses).
# Example: https://mcp.yourdomain.com
# Required: Yes
PUBLIC_FDM_MCP_URL=http://localhost:6174

# Comma-separated list of web page origins allowed to call the MCP server.
# Requests without an Origin header (desktop apps, command-line clients, servers) are always
# allowed. Leave empty to allow only localhost origins, such as the MCP Inspector.
# Example: https://app.yourdomain.com
# Required: No
FDM_MCP_ALLOWED_ORIGINS=

# -------------------------------------
# Database Configuration (PostgreSQL)
# -------------------------------------
# The same database as fdm-app and fdm-api.
# Required: Yes
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# -------------------------------------
# Authentication (Better Auth)
# -------------------------------------
# ⚠️  MUST be identical to BETTER_AUTH_SECRET in fdm-app, which issues the API keys.
# Required: Yes
BETTER_AUTH_SECRET=

# Full base URL of this service.
# Required: Yes
BETTER_AUTH_URL=http://localhost:6174

# -------------------------------------
# NMI Services (Optional)
# -------------------------------------
# NMI API key for indicators, measure options and nutrient advice.
# Required: No (these tools report that the service is not available without it)
NMI_API_KEY=

# -------------------------------------
# PostHog MCP analytics (Optional)
# -------------------------------------
# Records which tools are called, by which client, how long they take and whether they fail,
# per user. Tool arguments, results and error messages are never sent.
# Required: No (analytics are disabled when the key is not set)
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# -------------------------------------
# Sentry (Optional)
# -------------------------------------
# Required: No (error reporting is disabled when not set)
PUBLIC_SENTRY_DSN=
SENTRY_RELEASE=
PUBLIC_SENTRY_TRACE_SAMPLE_RATE=0.1
PUBLIC_SENTRY_PROFILE_SAMPLE_RATE=0
