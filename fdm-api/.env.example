# -------------------------------------
# General Configuration
# -------------------------------------
# Port the API server will listen on.
# Required: Yes (Defaults to 6173 for local dev, 8080 in production)
PORT=6173

# Public name of the application exposed in the OpenAPI document.
# Required: Yes
PUBLIC_FDM_NAME=FDM

# Canonical base URL of the API service (used for problem type links in error responses).
# Example: https://api.yourdomain.com
# Required: Yes
PUBLIC_FDM_URL=

# Comma-separated list of origins that are allowed to call this API (CORS).
# Leave empty to allow all origins (*). Restrict in production to your own domains.
# Example: https://app.yourdomain.com,https://staging.yourdomain.com
# Required: No (defaults to * — open to all origins)
FDM_API_ALLOWED_ORIGINS=

# -------------------------------------
# Database Configuration (PostgreSQL)
# -------------------------------------
# Required: Yes
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# -------------------------------------
# Authentication (Better Auth)
# -------------------------------------
# Secret key used by the better-auth library for token signing.
# Generate with: openssl rand -base64 32
# Required: Yes
# ⚠️  MUST be identical to BETTER_AUTH_SECRET in fdm-app — fdm-api validates
#     API keys that were issued by fdm-app's Better Auth instance, so both
#     services must share the same secret to verify tokens correctly.
BETTER_AUTH_SECRET=

# Full base URL of this API service (used for Better Auth cookie domain / redirects).
# Example: https://api.yourdomain.com
# Required: Yes
BETTER_AUTH_URL=

# -------------------------------------
# Sentry (Optional)
# -------------------------------------
# Sentry DSN for error tracking and performance monitoring.
# Required: No (error reporting is disabled when not set)
PUBLIC_SENTRY_DSN=

# Sentry release identifier (used to correlate errors to a specific deployment).
# If not set, falls back to npm_package_version.
# Required: No
SENTRY_RELEASE=

# Fraction of transactions to record for performance tracing (0.0–1.0).
# Required: No (defaults to 0.1 — 10%)
PUBLIC_SENTRY_TRACE_SAMPLE_RATE=0.1

# Fraction of trace sessions to profile (0.0–1.0).
# Required: No (defaults to 0 — profiling disabled)
PUBLIC_SENTRY_PROFILE_SAMPLE_RATE=0

# -------------------------------------
# NMI Services (Optional)
# -------------------------------------
# NMI API key for nutrient advice, indicators, reading lab reports, fertilizer plans,
# and the soil estimates of new fields after a field import.
# Required: No (these endpoints return 503 without it)
NMI_API_KEY=

# -------------------------------------
# Google Cloud Storage (Optional)
# -------------------------------------
# GCS bucket for uploaded and generated files: lab reports, soil photos and fertilizer plans.
# Use the same bucket as fdm-app, so both services share the files.
# Required: No (the file endpoints return 503 without it)
GCS_BUCKET_NAME=

# Authentication — choose ONE of the following methods (in order of preference):
#
# 1. Application Default Credentials (ADC) — recommended.
#    • On GCP (Cloud Run / GKE / GCE / App Engine): attach a service account to
#      the runtime. No env vars required beyond GCS_BUCKET_NAME.
#    • Locally: run `gcloud auth application-default login`.
#    • Any environment: set GOOGLE_APPLICATION_CREDENTIALS to the path of a
#      Workload Identity Federation configuration file (avoids long-lived keys).
#
# 2. Workload Identity Federation (non-GCP deployments).
#    Set GOOGLE_APPLICATION_CREDENTIALS to the path of the WIF config file AND
#    set GCS_SERVICE_ACCOUNT_EMAIL so the library knows which SA to sign as.
#    Docs: https://cloud.google.com/iam/docs/workload-identity-federation
#
GOOGLE_APPLICATION_CREDENTIALS=
GCS_SERVICE_ACCOUNT_EMAIL=

# 3. Inline service account key — NOT recommended (long-lived credential).
#    Only use when ADC and WIF are not available.
#    Base64-encode a JSON key file: base64 -w 0 service-account-key.json
#    The service account needs roles/storage.objectAdmin on GCS_BUCKET_NAME.
#
GCS_SERVICE_ACCOUNT_KEY=

# -------------------------------------
# Reports (Optional)
# -------------------------------------
# Paths to the images (PNG or JPEG) shown in generated fertilizer plans. The files must be
# available to the API process (for example inside the container).
# Required: No (without them, the plan shows only PUBLIC_FDM_NAME)
FDM_REPORT_LOGO=
FDM_REPORT_LOGO_INVERTED=
FDM_REPORT_COVER=
