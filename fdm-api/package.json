{
  "name": "@nmi-agro/fdm-api",
  "version": "0.2.5",
  "private": true,
  "description": "Hono-based REST API for the Farm Data Model",
  "bin": {
    "fdm-api": "./dist/server.js"
  },
  "files": [
    "dist",
    "instrument.server.mjs"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "dotenvx run -- tsx watch src/server.ts",
    "start": "node dist/server.js",
    "document": "typedoc src/index.ts --plugin typedoc-plugin-missing-exports --skipErrorChecking",
    "check-types": "tsc --noEmit",
    "preinstall": "npx only-allow pnpm",
    "test": "vitest run",
    "test-coverage": "vitest run --coverage",
    "watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "^1.6.1",
    "@nmi-agro/fdm-calculator": "workspace:*",
    "@nmi-agro/fdm-core": "workspace:*",
    "@scalar/hono-api-reference": "^0.12.0",
    "@sentry/node": "^10.72.0",
    "@sentry/profiling-node": "^10.72.0",
    "drizzle-orm": "catalog:",
    "hono": "^4.13.5",
    "nanoid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "catalog:",
    "@scalar/openapi-parser": "^0.29.0",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsdown": "catalog:",
    "tsx": "^4.23.13",
    "typedoc": "catalog:",
    "typedoc-plugin-missing-exports": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
